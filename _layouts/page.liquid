<!DOCTYPE html>
<html lang="en">
{% include "head.liquid" %}
<body class="page">
  {% include "header.liquid" %}
  <main class="page-main">
    <article class="page-content">
      <h1>{{ page.title }}</h1>
      {% if page.data.updated %}
        <p class="page-meta">Last updated {{ page.data.updated | date: "%B %-d, %Y" }}</p>
      {% endif %}
      {{ page.content }}
    </article>
  </main>
  {% include "footer.liquid" %}
</body>
</html>
