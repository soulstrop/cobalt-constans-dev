<!DOCTYPE html>
<html lang="en">
{% include "head.liquid" %}
<body>
  <div class="page">
    {% include "header.liquid" %}

    <main>
      <div class="post-sidekick">
        <aside class="meta">
          <div class="row"><span class="l">kind</span><span class="v v-accent">paper</span></div>
          <div class="row"><span class="l">date</span><span class="v">{{ page.published_date | date: "%b %Y" }}</span></div>
          {%- if page.data.pages %}
          <div class="row"><span class="l">pages</span><span class="v">{{ page.data.pages }}</span></div>
          {%- endif %}
          {%- if page.tags %}
          <div class="row"><span class="l">tags</span><span class="v">{{ page.tags | join: " · " }}</span></div>
          {%- endif %}
          {%- if page.data.pdf_url %}
          <div class="row row-pdf">
            <a class="act primary act-sm" href="{{ page.data.pdf_url }}">Read full PDF <span class="arr">↗</span></a>
          </div>
          {%- endif %}
          <div class="row"><span class="l">— —</span><span class="v"><a href="/writing/">← all writing</a></span></div>
        </aside>
        <article class="paper">
          <header class="paper-head">
            <p class="paper-kicker">paper</p>
            <h1>{{ page.title }}<span class="dot">.</span></h1>
          </header>
          <section class="abstract">
            <h2>Abstract</h2>
            {{ page.content }}
          </section>
        </article>
      </div>
    </main>

    {% include "footer.liquid" %}
  </div>
</body>
</html>
