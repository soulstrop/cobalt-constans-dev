#!/usr/bin/env bash
# infra/tasks/list-cf
#
# Inspects the live Cloudflare zone and emits OpenTofu `import {}` blocks
# matching the resources declared in infra/*.tf. Read-only — does not
# mutate Cloudflare or your tf files.
#
# Usage (from anywhere):
#   TF_VAR_cloudflare_api_token=... infra/tasks/list-cf
#   TF_VAR_cloudflare_api_token=... infra/tasks/list-cf > infra/imports.tf
#
# zone_id is read from infra/terraform.tfvars by default; override with
# ZONE_ID=... infra/tasks/list-cf
#
# Anything found on Cloudflare that's NOT modeled in our tf is emitted as
# a "# skipped" comment so you can see what was intentionally left out.

set -euo pipefail

: "${TF_VAR_cloudflare_api_token:?set TF_VAR_cloudflare_api_token first}"

cd "$(dirname "$0")/.."

ZONE_ID="${ZONE_ID:-$(grep -E '^[[:space:]]*zone_id' terraform.tfvars 2>/dev/null | sed -E 's/.*"([^"]+)".*/\1/' || true)}"
: "${ZONE_ID:?could not determine zone_id (set ZONE_ID env var, or fill in terraform.tfvars)}"

DOMAIN="${DOMAIN:-constans.dev}"

API="https://api.cloudflare.com/client/v4"
auth=(-sH "Authorization: Bearer $TF_VAR_cloudflare_api_token")

dns="$(curl "${auth[@]}" "$API/zones/$ZONE_ID/dns_records?per_page=100" | jq '.result')"
routes="$(curl "${auth[@]}" "$API/zones/$ZONE_ID/workers/routes" | jq '.result')"

cat <<EOF
# === auto-generated by infra/tasks/list-cf ===
# Paste into imports.tf (or pipe straight into it), run \`tofu plan\` to
# verify "0 to change", then \`tofu apply\`.
# Delete imports.tf after the first successful apply — they are one-shot.

# --- Zone settings (synthetic IDs) -------------------------------------------
EOF
for s in ssl always_use_https min_tls_version; do
cat <<EOF

import {
  to = cloudflare_zone_setting.$s
  id = "$ZONE_ID/$s"
}
EOF
done

echo
echo "# --- DNS records ------------------------------------------------------------"
echo "$dns" | jq -r --arg domain "$DOMAIN" --arg zid "$ZONE_ID" '
  .[]
  | if   .name == $domain         and .type == "A"
    then "\nimport {\n  to = cloudflare_dns_record.apex[\"\(.content)\"]\n  id = \"\($zid)/\(.id)\"\n}"
    elif .name == "www."+$domain      and .type == "CNAME"
    then "\nimport {\n  to = cloudflare_dns_record.www\n  id = \"\($zid)/\(.id)\"\n}"
    elif .name == "staging."+$domain  and .type == "CNAME"
    then "\nimport {\n  to = cloudflare_dns_record.staging\n  id = \"\($zid)/\(.id)\"\n}"
    else "# skipped (not modeled in tf): \(.type) \(.name) → \(.content)"
    end'

echo
echo "# --- Worker routes ----------------------------------------------------------"
echo "$routes" | jq -r --arg domain "$DOMAIN" --arg zid "$ZONE_ID" '
  .[]
  | if   .pattern == "staging."+$domain+"/*"
    then "\nimport {\n  to = cloudflare_workers_route.staging\n  id = \"\($zid)/\(.id)\"\n}"
    else "# skipped (not modeled in tf): \(.pattern)"
    end'
